# StoryVerse Skills - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.sample .env

# ============================================
# Backend API
# ============================================
STORYVERSE_BACKEND_URL=http://34.204.80.155/api/v1
STORYVERSE_API_TOKEN=              # JWT token from /auth/login

# ============================================
# MCP Server (image/video generation via fal.ai)
# ============================================
STORYVERSE_MCP_URL=https://cdpx7nw32d.us-east-1.awsapprunner.com/mcp
BEARER_TOKEN=storyverse2026        # MCP server bearer token
FAL_KEY=                           # fal.ai API key - fallback when MCP server is unavailable

# ============================================
# AI Services
# ============================================
ELEVENLABS_API_KEY=                # ElevenLabs API key (voice, STT, music)
GEMINI_API_KEY=                    # Google Gemini API key (BGM analysis, transitions)
OPENAI_API_KEY=                    # OpenAI API key (script generation)

# ============================================
# LangSmith (optional - tracing)
# ============================================
LANGSMITH_API_KEY=                 # LangSmith API key (https://smith.langchain.com/settings)
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=storyverse-skills
